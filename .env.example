REPLICON_BASE_URL=https://eu1.replicon.com

# --- Auth: use ONE of the two options below ---

# Option A — Basic Auth (default/easiest: just your normal Replicon login)
REPLICON_COMPANY_KEY=<your company key, e.g. the part after eu1.replicon.com/ in your login URL>
REPLICON_USERNAME=<your Replicon login email>
REPLICON_PASSWORD=<your Replicon login password>

# Option B — Bearer token (advanced/optional; comment out Option A above if using this)
# REPLICON_BEARER_TOKEN=<paste your generated token here>

# --- Your user URI ---
# Leave blank at first. Set REPLICON_BASE_URL and your auth above, then run:
#   python find_my_user_uri.py "Your Name"
# and paste the URI it prints here.
REPLICON_USER_URI=<paste your Replicon user URI here>
