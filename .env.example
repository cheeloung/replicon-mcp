REPLICON_BASE_URL=https://eu1.replicon.com

# --- Auth: use ONE of the two options below ---

# Option A — Basic Auth (default/easiest: just your normal Replicon login)
REPLICON_COMPANY_KEY=<your company key, e.g. the part after eu1.replicon.com/ in your login URL>
REPLICON_USERNAME=<your Replicon login email>
REPLICON_PASSWORD=<your Replicon login password>

# Option B — Bearer token (advanced/optional; comment out Option A above if using this)
# REPLICON_BEARER_TOKEN=<paste your generated token here>

# --- Your user URI ---
# Leave blank at first. Set REPLICON_BASE_URL and your auth above, then run:
#   python find_my_user_uri.py "Your Name"
# and paste the URI it prints here.
# Only used in local/stdio mode — in remote/hosted mode each teammate's user
# URI is resolved automatically by the /link web flow instead (see below).
REPLICON_USER_URI=<paste your Replicon user URI here>

# --- Remote/hosted mode only (TRANSPORT=streamable-http) ---
# Local stdio usage (the default) ignores everything below. REPLICON_BASE_URL
# above stays in effect (shared across the whole tenant); REPLICON_COMPANY_KEY/
# USERNAME/PASSWORD/BEARER_TOKEN/USER_URI above are NOT used in this mode —
# each teammate links their own personal API token via the /link web flow
# instead (Basic Auth fails outright for accounts with 2-step verification
# enabled, so /link collects a bearer token, not username/password — see
# credentials.py and docs/remote-hosting.md).
TRANSPORT=stdio
PORT=8001
# Public HTTPS URL the reverse proxy exposes this server on (no trailing slash).
PUBLIC_URL=https://replicon-mcp.kranzwolfe.com
# Azure App Registration in the Kranz Wolfe Entra ID tenant, dedicated to
# replicon-mcp — do NOT reuse tuleap-mcp's (see docs/remote-hosting.md).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# This server acts as the full OAuth Authorization Server for MCP clients
# (claude.ai expects /authorize + /token on this same domain, not a
# delegated external AS — see oauth_provider.py). ENTRA_CLIENT_ID above is
# reused as the client_id these MCP clients present; this is the exact
# redirect_uri each one uses, comma-separated if there's more than one.
# claude.ai's is https://claude.ai/api/mcp/auth_callback — confirmed by
# actually attempting to add the connector and reading it off the failed
# /authorize request, not documented anywhere in advance.
MCP_CLIENT_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
# Fernet key encrypting linked Replicon credentials at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_STORE_KEY=
# Where the encrypted per-user credential store lives.
CREDENTIAL_DB_PATH=replicon-mcp-credentials.db
